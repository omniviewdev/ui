{
  "name": "@omniviewdev/base-ui",
  "version": "0.7.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Omniview Base UI component library built with Base UI primitives and static CSS tokens.",
  "repository": {
    "type": "git",
    "url": "https://github.com/omniviewdev/ui.git",
    "directory": "packages/base-ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/base-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rm -rf dist storybook-static coverage",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:token-keys": "tsx scripts/generate-token-keys.ts",
    "test:types": "vitest run --typecheck src/theme/types.test-d.test.ts"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.23",
    "react-syntax-highlighter": "16.1.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "react-icons": "5.7.0",
    "storybook": "10.6.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "vite-plugin-dts": "5.1.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@testing-library/dom": "10.4.2",
    "@microsoft/api-extractor": "7.60.0"
  }
}
