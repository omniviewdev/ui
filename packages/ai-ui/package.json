{
  "name": "@omniviewdev/ai-ui",
  "version": "6.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Omniview AI UI components for chat, streaming, reasoning, and agent interfaces.",
  "repository": {
    "type": "git",
    "url": "https://github.com/omniviewdev/ui.git",
    "directory": "packages/ai-ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/ai-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rm -rf dist storybook-static coverage",
    "build": "vite build",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@omniviewdev/base-ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.23",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@omniviewdev/base-ui": "workspace:*",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "react-icons": "5.7.0",
    "storybook": "10.6.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@testing-library/dom": "10.4.2",
    "@microsoft/api-extractor": "7.60.0"
  }
}
