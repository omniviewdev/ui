{
  "name": "omniview-ui-base",
  "private": true,
  "version": "0.0.1",
  "description": "Planning and standards repository for Omniview's Base UI migration.",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:base": "pnpm --filter @omniviewdev/base-ui storybook",
    "storybook:ai": "pnpm --filter @omniviewdev/ai-ui storybook",
    "storybook:editors": "pnpm --filter @omniviewdev/editors storybook",
    "build-storybook": "storybook build -c .storybook -o storybook-static",
    "build-storybook:ai": "pnpm --filter @omniviewdev/ai-ui build-storybook",
    "audit:ui": "node scripts/audit/index.mjs",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm audit:ui && pnpm test",
    "bench": "pnpm --filter @omniviewdev/benchmarks exec vitest bench --run",
    "bench:browser": "pnpm --filter @omniviewdev/benchmarks exec vitest bench --config vitest.config.browser.ts --run",
    "bench:trace": "TRACE=true pnpm bench:browser",
    "bench:deterministic": "DETERMINISTIC=true pnpm bench",
    "bench:json": "mkdir -p packages/benchmarks/results && pnpm --filter @omniviewdev/benchmarks exec vitest bench --run --reporter=default --reporter=json --outputFile=results/latest.json",
    "bench:competitive": "pnpm --filter @omniviewdev/benchmarks exec vitest bench --config vitest.config.competitive.ts --run",
    "bench:competitive:json": "mkdir -p packages/benchmarks/results/competitive && pnpm --filter @omniviewdev/benchmarks exec vitest bench --config vitest.config.competitive.ts --run --reporter=default --reporter=json --outputFile=results/competitive/latest.json",
    "showcase": "pnpm --filter @omniviewdev/showcase dev",
    "showcase:build": "pnpm --filter @omniviewdev/showcase build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "glob": "13.0.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@eslint-react/eslint-plugin": "5.28.8",
    "vite": "7.3.7"
  }
}
