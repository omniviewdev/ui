{
  "name": "@omniviewdev/showcase",
  "version": "0.0.1",
  "private": true,
  "description": "Demo showcase app built entirely from Omniview UI packages.",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter \"@omniviewdev/showcase^...\" build",
    "dev": "pnpm build:deps && vite",
    "dev:fast": "vite",
    "build": "pnpm build:deps && node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@omniviewdev/base-ui": "workspace:*",
    "@omniviewdev/ai-ui": "workspace:*",
    "@omniviewdev/editors": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tanstack/react-table": "9.3.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
