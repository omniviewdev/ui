{
  "name": "@omniviewdev/editors",
  "version": "6.1.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Omniview editor components — code editor, diff viewer, terminal, markdown preview, command palette, object inspector.",
  "repository": {
    "type": "git",
    "url": "https://github.com/omniviewdev/ui.git",
    "directory": "packages/editors"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/editors.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rm -rf dist storybook-static coverage",
    "build": "vite build",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@omniviewdev/base-ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.52.2",
    "monaco-yaml": "5.5.1",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "storybook": "10.6.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@testing-library/dom": "10.4.2",
    "@microsoft/api-extractor": "7.60.0"
  }
}
